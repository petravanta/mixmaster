{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Glasses",
 "description": "Glassware a recipe can be served in.",
 "type": "array",
 "items": {
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name"],
  "properties": {
   "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Stable id that recipes refer to." },
   "name": { "type": "string", "minLength": 1, "description": "What the app shows." }
  }
 }
}
